/**
 * Firebase Firestore Security Rules - EloSUS Grupos
 *
 * Princípios de Segurança:
 * 1. Role-based access control (RBAC) com Custom Claims
 * 2. Isolamento por unidade de saúde
 * 3. Dados clínicos protegidos por autorização explícita
 * 4. Auditoria de acessos sensíveis
 * 5. Negação por padrão (allow only if explicitly granted)
 *
 * Deploy: firebase deploy --only firestore:rules
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== FUNÇÕES AUXILIARES ==========

    /**
     * Verifica se o usuário é o dono do documento
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * Verifica se é Admin (via Custom Claims)
     */
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    /**
     * Verifica se é Profissional (via Custom Claims)
     */
    function isProfessional() {
      return request.auth != null && request.auth.token.role == 'professional';
    }

    /**
     * Verifica se é Paciente (via Custom Claims)
     */
    function isPatient() {
      return request.auth != null && request.auth.token.role == 'patient';
    }

    /**
     * Verifica se membro de um grupo
     */
    function isMemberOfGroup(groupId) {
      return request.auth != null &&
             request.auth.uid in get(/databases/$(database)/documents/grupos/$(groupId)).data.participants;
    }

    /**
     * Verifica se profissional responsável por um grupo
     */
    function isProfessionalOfGroup(groupId) {
      let group = get(/databases/$(database)/documents/grupos/$(groupId)).data;
      return isProfessional() &&
             request.auth.token.unitId == group.unidadeSaudeId;
    }

    /**
     * Verifica se usuário está na mesma unidade de saúde
     */
    function isSameUnit(unitId) {
      return request.auth.token.unitId == unitId;
    }

    /**
     * Verifica se admin ou profissional autorizado
     */
    function isAuthorizedForHealthcare() {
      return isAdmin() || isProfessional();
    }

    // ========== COLEÇÃO: USERS ==========
    /**
     * Documentos de usuário
     * Contêm perfil, avatar, settings (NÃO contêm dados clínicos sensíveis)
     * Role é SOMENTE LEITURA (atribuído por backend via Custom Claims)
     */
    match /users/{userId} {
      // Leitura: Qualquer autenticado pode ler perfis básicos
      // (necessário para exibir nomes em grupos, chats, etc)
      allow read: if request.auth != null;

      // Criação: Apenas o próprio usuário
      // IMPORTANTE: role NÃO pode ser incluído (ou deve ser null)
      // role será atribuído APENAS por backend via Custom Claims
      allow create: if isOwner(userId) &&
                    (!('role' in request.resource.data) ||
                     request.resource.data.role == null);

      // Atualização: Proprietário pode editar, MAS...
      // role e qualquer campo crítico de autorização NÃO podem ser alterados
      allow update: if isOwner(userId) &&
                    !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
                    !('professionalStatus' in request.resource.data.diff(resource.data).affectedKeys());

      // Deleção: Apenas o proprietário (e admin em casos especiais)
      allow delete: if isOwner(userId) || isAdmin();

      // Subcoleções de usuário (mood_logs, etc) - apenas o dono acessa
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ========== COLEÇÃO: PATIENTS ==========
    /**
     * Registros clínicos de pacientes
     * Contêm: dados de saúde, screenings, histórico clínico
     * Acesso: Apenas profissionais/admins + paciente a seus próprios
     */
    match /patients/{patientId} {
      // Paciente acessa apenas seus próprios dados
      // Profissional acessa apenas pacientes de sua unidade
      // Admin acessa apenas pacientes de sua unidade
      allow read: if (isPatient() && request.auth.uid == resource.data.userId) ||
                  (isAuthorizedForHealthcare() && 
                   isSameUnit(resource.data.unidadeSaudeId));

      // Criação/edição: Profissional ou admin da unidade
      allow create: if isAuthorizedForHealthcare() &&
                    isSameUnit(request.resource.data.unidadeSaudeId);

      allow update: if isAuthorizedForHealthcare() &&
                    isSameUnit(resource.data.unidadeSaudeId);

      // Deleção: Apenas admin
      allow delete: if isAdmin() && isSameUnit(resource.data.unidadeSaudeId);

      // Subcoleções clínicas: Acesso controlado por documento pai
      match /moodEntries/{entryId} {
        allow read: if (request.auth.uid == get(/databases/$(database)/documents/patients/$(patientId)).data.userId) ||
                    isAuthorizedForHealthcare();
        allow create, update: if request.auth.uid == get(/databases/$(database)/documents/patients/$(patientId)).data.userId;
        allow delete: if isAuthorizedForHealthcare();
      }

      match /screenings/{screeningId} {
        allow read, write: if isAuthorizedForHealthcare();
      }

      match /attendance/{attendanceId} {
        allow read, write: if isAuthorizedForHealthcare();
      }

      match /notes/{noteId} {
        allow read: if isAuthorizedForHealthcare();
        allow create, update: if isAuthorizedForHealthcare();
        allow delete: if isAuthorizedForHealthcare();
      }
    }

    // ========== COLEÇÃO: GRUPOS (TERAPÊUTICOS) ==========
    /**
     * Grupos terapêuticos e atividades coletivas
     */
    match /grupos/{groupId} {
      // Leitura: Membros do grupo + profissionais da unidade
      let group = get(/databases/$(database)/documents/grupos/$(groupId)).data;
      allow read: if isMemberOfGroup(groupId) ||
                  (isAuthorizedForHealthcare() && 
                   isSameUnit(group.unidadeSaudeId));

      // Criação/edição: Profissional ou admin da unidade
      allow create, update: if isAuthorizedForHealthcare() &&
                            isSameUnit(request.resource.data.unidadeSaudeId);

      // Deleção: Apenas admin
      allow delete: if isAdmin();

      // Subcoleções: Acesso controlado

      match /members/{memberId} {
        allow read: if isMemberOfGroup(groupId) ||
                    isProfessionalOfGroup(groupId);
        allow write: if isProfessionalOfGroup(groupId);
      }

      match /messages/{messageId} {
        // Leitura: Membros + profissionais
        allow read: if isMemberOfGroup(groupId) ||
                    isProfessionalOfGroup(groupId);

        // Escrita: Qualquer membro pode enviar mensagem
        allow create: if isMemberOfGroup(groupId);

        // Edição/deleção: Apenas autor ou admin
        allow update, delete: if request.auth.uid == resource.data.authorId ||
                              isProfessionalOfGroup(groupId);
      }

      match /attendance/{attendanceId} {
        allow read: if isProfessionalOfGroup(groupId);
        allow write: if isProfessionalOfGroup(groupId);
      }

      match /notifications/{notificationId} {
        allow read: if isMemberOfGroup(groupId);
        allow create: if isProfessionalOfGroup(groupId);
        allow delete: if isProfessionalOfGroup(groupId);
      }
    }

    // ========== COLEÇÃO: SESSIONS (ENCONTROS) ==========
    match /sessions/{sessionId} {
      let session = resource.data;
      allow read: if isProfessionalOfGroup(session.groupId) ||
                  (isPatient() && 
                   request.auth.uid in get(/databases/$(database)/documents/grupos/$(session.groupId)).data.participants);

      allow create, update: if isProfessional();
      allow delete: if isAdmin();
    }

    // ========== COLEÇÃO: APPOINTMENTS ==========
    match /appointments/{appointmentId} {
      let appt = resource.data;
      
      allow read: if (isPatient() && request.auth.uid == appt.patientId) ||
                  (isAuthorizedForHealthcare() &&
                   isSameUnit(appt.unidadeSaudeId));

      allow create, update: if isAuthorizedForHealthcare() &&
                            isSameUnit(request.resource.data.unidadeSaudeId);

      allow delete: if isAuthorizedForHealthcare();
    }

    // ========== COLEÇÃO: REFERRALS ==========
    match /referrals/{referralId} {
      let referral = resource.data;
      
      allow read: if (isPatient() && request.auth.uid == referral.patientId) ||
                  isAuthorizedForHealthcare();

      allow create, update: if isAuthorizedForHealthcare();
      allow delete: if isAuthorizedForHealthcare();
    }

    // ========== COLEÇÃO: TOBACCO_ANAMNESIS ==========
    match /tobacco_anamnesis/{anamnesisId} {
      let anamnesis = resource.data;
      
      allow read: if (isPatient() && request.auth.uid == anamnesis.patientId) ||
                  isAuthorizedForHealthcare();

      allow create: if isPatient() && 
                    request.auth.uid == request.resource.data.patientId;

      allow update: if (isPatient() && request.auth.uid == resource.data.patientId) ||
                    isAuthorizedForHealthcare();

      allow delete: if isAuthorizedForHealthcare();
    }

    // ========== COLEÇÃO: MATERIALS (CONTEÚDO) ==========
    match /materials/{materialId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAuthorizedForHealthcare();
    }

    // ========== COLEÇÃO: HEALTH_UNITS ==========
    match /healthUnits/{unitId} {
      // Leitura: Qualquer autenticado (metadados públicos da rede)
      allow read: if request.auth != null;

      // Escrita: Apenas admin
      allow write: if isAdmin();
    }

    // ========== COLEÇÃO: QUIZZES ==========
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if isAuthorizedForHealthcare();
    }

    // ========== COLEÇÃO: NEWS ==========
    match /news/{newsId} {
      allow read: if request.auth != null;
      allow write: if isAuthorizedForHealthcare();
    }

    // ========== COLEÇÃO: NOTIFICATIONS ==========
    match /notifications/{notificationId} {
      let notification = resource.data;
      
      // Usuário pode ler apenas suas notificações
      allow read: if isOwner(notification.userId);

      allow write: if isOwner(notification.userId);
      allow delete: if isOwner(notification.userId);
    }

    // ========== COLEÇÃO: PROFESSIONAL_REQUESTS ==========
    /**
     * Solicitações para upgrade de paciente → profissional
     * Controlado por Cloud Functions, aqui apenas log
     */
    match /professional_requests/{requestId} {
      let request_doc = resource.data;
      
      // Usuário vê suas próprias solicitações
      allow read: if isOwner(request_doc.uid) || isAdmin();

      // Criação via Cloud Function apenas
      allow create: if false;

      // Atualização via Cloud Function apenas
      allow update: if false;

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ========== COLEÇÃO: AUDIT_LOGS ==========
    /**
     * Registros de auditoria (somente leitura via backend)
     */
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Criação via Cloud Function apenas
    }

    // ========== PADRÃO DE NEGAÇÃO ==========
    /**
     * Por padrão, TODAS as operações são bloqueadas
     * Segurança por princípio do menor privilégio
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
